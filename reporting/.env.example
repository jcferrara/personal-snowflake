# Snowflake connection for Observable Framework data loaders.
# Key-pair (JWT) auth — same convention as ../extraction/.env.example and
# the dbt CI workflow. Copy this file to reporting/.env and fill it in.
# reporting/.env is gitignored.

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
