# Garmin Connect credentials
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=changeme

# ESPN Fantasy Football (private league — cookies from a logged-in browser
# session; see extraction/README.md "ESPN Fantasy Football")
ESPN_LEAGUE_ID=123456
ESPN_S2=paste-your-espn_s2-cookie-value-here
ESPN_SWID={PASTE-YOUR-SWID-COOKIE-INCLUDING-BRACES}
ESPN_FIRST_SEASON=2015

# Plaid (production). Client ID/secret from the Plaid dashboard's API keys
# page; PLAID_ENV must be "production" for real bank/investment data (see
# extraction/README.md "Plaid") — use "sandbox" to build/test against Plaid's
# test institutions first. PLAID_ACCESS_TOKENS is a JSON array, one entry per
# linked institution/Item — generate entries by running
# `python -m plaid_extract.link_item` locally once per institution and
# pasting its printed output into this array.
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-production-secret
PLAID_ENV=production
PLAID_ACCESS_TOKENS=[{"item_id":"item-xxx","access_token":"access-xxx","nickname":"Chase Checking"}]

# Snowflake connection (EXTRACTOR role, EXTRACT_WH warehouse, RAW database).
# SNOWFLAKE_SCHEMA is used by the Garmin source; the fantasy_football and
# plaid sources always write to their own fixed schema regardless of this
# value.
SNOWFLAKE_ACCOUNT=your-account-locator
SNOWFLAKE_USER=your-snowflake-username
SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/your/rsa_key.p8
SNOWFLAKE_ROLE=role
SNOWFLAKE_WAREHOUSE=wh
SNOWFLAKE_DATABASE=db
SNOWFLAKE_SCHEMA=schema
